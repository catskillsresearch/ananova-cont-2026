theorem rpow_le_potentialProfile {r : ℝ} (hr1 : r ≤ 1) :
    r ^ (2 - (d : ℝ)) ≤ potentialProfile d r := by
  unfold potentialProfile
  split_ifs with h1 h2
  · subst h1; norm_num; exact hr1
