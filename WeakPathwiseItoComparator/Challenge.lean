        (∫ y, (h - g) y * ψ n (x - y)) + ((∫ y, g y * ψ n (x - y)) - g x) + (g - h) x := by
      have : ∫ y, (h - g) y * ψ n (x - y) = (∫ y, h y * ψ n (x - y)) - ∫ y, g y * ψ n (x - y) := by
        rw [← integral_sub (hint hh n x) (hint hgi n x)]
