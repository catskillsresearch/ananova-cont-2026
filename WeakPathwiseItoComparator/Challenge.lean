def GeometricMeshDecay {T : ℝ} (π : ℕ → Partition T) : Prop :=
  ∃ M₂ : ℝ, 1 < M₂ ∧ ∀ n, 1 ≤ n → M₂ ≤ (π n).mesh / (π (n + 1)).mesh

