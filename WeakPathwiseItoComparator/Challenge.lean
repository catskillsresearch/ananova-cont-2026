/-- `x` is a Lebesgue point of `f`: `⨍_{B(x,r)} |f(y) - c| dy → 0` as `r → 0` for some `c`. -/
def IsLebesguePoint {d : ℕ} (f : Rd d → ℝ) (x : Rd d) : Prop :=
