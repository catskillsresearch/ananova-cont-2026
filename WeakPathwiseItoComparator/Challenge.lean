theorem integral_closedBall_affine (m : Rd d) {l : ℝ} (hl : 0 < l) (L : Rd d ≃ₗᵢ[ℝ] Rd d)
    (g : Rd d → ℝ) :
    ∫ x in Metric.closedBall m (l / 2), g x =
