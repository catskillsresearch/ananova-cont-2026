/-! ## `WeakPathwiseIto.Bessel.CanonicalWienerSpace` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The canonical path space `Ω := C([0, T], ℝ^d)` of Section 2.2, with its Borel σ-algebra. -/
abbrev CanonicalWienerSpace (d : ℕ) (T : ℝ) : Type := C(Icc (0 : ℝ) T, Rd d)

namespace CanonicalWienerSpace

variable {d : ℕ} {T : ℝ}

/-- The canonical coordinate process `B(t)(ω) := ω(t)` for `t ∈ [0, T]` (and `0` off `[0, T]`). -/
def B (t : ℝ) (ω : CanonicalWienerSpace d T) : Rd d := if h : t ∈ Icc 0 T then ω ⟨t, h⟩ else 0

/-- The path `t ↦ B(t)(ω)`, as a path `ℝ → ℝ^d` for the pathwise theory along partitions of
`[0, T]`. -/
def path (ω : CanonicalWienerSpace d T) : ℝ → Rd d := fun t => B t ω

/-- The element `t ↦ x + ∑_i W^i(t) e_i` of `Ω` built from `d` continuous real paths `W^i`. -/
def ofCoords (x : Rd d) (W : Fin d → ℝ≥0 → ℝ) (hW : ∀ i, Continuous (W i)) :
    CanonicalWienerSpace d T :=
  ⟨fun s => x + ∑ i, W i (s : ℝ).toNNReal • Rd.basisVec i,
    continuous_const.add (continuous_finset_sum _ fun i _ =>
      ((hW i).comp (continuous_real_toNNReal.comp continuous_subtype_val)).smul continuous_const)⟩

/-- `P` is the law of `d`-dimensional Brownian motion started at `x`, on `Ω`: the image of a
probability `Q` under `ω' ↦ (t ↦ x + ∑_i W^i_t(ω') e_i)` for independent real Brownian motions
`W^1, …, W^d` (Mathlib's `ProbabilityTheory.IsBrownianReal`) with continuous paths. -/
def IsLaw (x : Rd d) (P : Measure (CanonicalWienerSpace d T)) : Prop :=
  ∃ (Ω' : Type) (_ : MeasurableSpace Ω') (Q : Measure Ω') (W : Fin d → ℝ≥0 → Ω' → ℝ)
    (hW : ∀ i ω', Continuous fun t => W i t ω'),
    IsProbabilityMeasure Q ∧ (∀ i, ProbabilityTheory.IsBrownianReal (W i) Q) ∧
    ProbabilityTheory.iIndepFun (fun i ω' t => W i t ω') Q ∧
    P = Q.map fun ω' => ofCoords x (fun i t => W i t ω') fun i => hW i ω'

/-- The law `ℙ_x` of Brownian motion started at `x` on the canonical space
`Ω = C([0, T], ℝ^d)` (Section 2.2): the measure satisfying `IsLaw x`, which exists and is
unique (`CanonicalWienerSpace.exists_isLaw`, `CanonicalWienerSpace.isLaw_unique`). -/
def P (x : Rd d) : Measure (CanonicalWienerSpace d T) := Classical.epsilon (IsLaw x)

end CanonicalWienerSpace

end

/-! ## `WeakPathwiseIto.Bessel.BesselKernel` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The Bessel kernel `g_α` on `ℝ^d` (Definition 2.4), given by the subordination formula
`g_α(x) = ((4π)^{α/2} Γ(α/2))⁻¹ ∫_0^∞ e^{-π|x|²/δ} e^{-δ/(4π)} δ^{(α-d)/2} dδ/δ`
[Ste70, Ch. V §3]; its defining property `ĝ_α(ξ) = (1 + 4π²|ξ|²)^{-α/2}` is
`besselKernel.fourier_eq`. -/
def besselKernel (d : ℕ) (α : ℝ) (x : Rd d) : ℝ :=
  ((4 * Real.pi) ^ (α / 2) * Real.Gamma (α / 2))⁻¹ *
    ∫ δ in Ioi (0 : ℝ), Real.exp (-Real.pi * ‖x‖ ^ 2 / δ) * Real.exp (-δ / (4 * Real.pi)) *
      δ ^ ((α - d) / 2) / δ

namespace besselKernel

variable {d : ℕ} {α : ℝ}

/-- **Subgoal** (Definition 2.4). -/
theorem nonneg (hα : 0 < α) (x : Rd d) : 0 ≤ besselKernel d α x := by
  unfold besselKernel
  refine mul_nonneg (inv_nonneg.2 (mul_pos (Real.rpow_pos_of_pos (by positivity) _)
    (Real.Gamma_pos_of_pos (by linarith))).le) ?_
  refine setIntegral_nonneg measurableSet_Ioi fun δ hδ => ?_
  have hδ' : 0 < δ := hδ
  exact div_nonneg (mul_nonneg (mul_nonneg (Real.exp_pos _).le (Real.exp_pos _).le)
    (Real.rpow_nonneg hδ'.le _)) hδ'.le

end besselKernel

end

/-! ## `WeakPathwiseIto.Bessel.BesselSpace` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

namespace BesselSpace

/-- The Bessel potential `g_α ⋆ f`, with the convention `g_0 ⋆ f = f`. -/
def potential (d : ℕ) (α : ℝ) (f : Rd d → ℝ) : Rd d → ℝ :=
  if α = 0 then f else fun x => ∫ y, besselKernel d α (x - y) * f y

end BesselSpace

/-- The Bessel space `𝓛^p_α(ℝ^d) := {g_α ⋆ f : f ∈ L^p(ℝ^d)}` (Definition 2.5), with
functions identified up to a.e. equality. -/
def BesselSpace (d : ℕ) (α : ℝ) (p : ℝ≥0∞) : Set (Rd d → ℝ) :=
  {F | ∃ f : Rd d → ℝ, MemLp f p ∧ F =ᵐ[volume] BesselSpace.potential d α f}

namespace BesselSpace

variable {d : ℕ}

/-- The norm `‖F‖_{𝓛^p_α} := ‖f‖_{L^p}` where `F = g_α ⋆ f` (Definition 2.5). -/
def norm (α : ℝ) (p : ℝ≥0∞) (F : Rd d → ℝ) : ℝ≥0∞ :=
  ⨅ (f : Rd d → ℝ) (_ : MemLp f p) (_ : F =ᵐ[volume] potential d α f), eLpNorm f p volume

end BesselSpace

end

/-! ## `WeakPathwiseIto.Bessel.BesselCapacity` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The Bessel `(α, p)`-capacity (Definition 2.7):
`B_{α,p}(E) := inf {‖h‖_p^p : g_α ⋆ h ≥ 1_E, h ≥ 0}`. -/
def besselCapacity (d : ℕ) (α : ℝ) (p : ℝ≥0∞) (S : Set (Rd d)) : ℝ≥0∞ :=
  ⨅ (h : Rd d → ℝ) (_ : 0 ≤ h) (_ : ∀ x ∈ S, 1 ≤ BesselSpace.potential d α h x),
    eLpNorm h p volume ^ p.toReal

namespace besselCapacity

variable {d : ℕ}

/-- `S` is `(α, p)`-polar: `B_{α,p}(S) = 0` (Definition 2.7). -/
def IsNull (d : ℕ) (α : ℝ) (p : ℝ≥0∞) (S : Set (Rd d)) : Prop := besselCapacity d α p S = 0

end besselCapacity

end

