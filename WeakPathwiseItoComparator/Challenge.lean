theorem sum_rpow_le {p : ℝ} (hp : 1 ≤ p) (π : Partition T) (ω : ℝ → Rd d) (h : Rd d → ℝ≥0∞) :
    (∑ i : Fin π.m, ((h (ω (π.right i)) + h (ω (π.left i))) *
