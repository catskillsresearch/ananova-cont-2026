  have h0 : f (ω 0) = f (ω (min (p.t 0) t)) := by rw [p.t_zero, min_eq_left ht.1]
  rw [Finset.sum_sub_distrib, hT, h0]
  change _ = ∑ k : Fin p.m, f (ω (min (p.t k.succ) t)) - ∑ k : Fin p.m, f (ω (min (p.t k.castSucc) t))
