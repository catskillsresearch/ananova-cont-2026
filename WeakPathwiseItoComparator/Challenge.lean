/-- **Assumption 1** (balanced partitions), eq. (26): `M₁ := sup_{n ≥ 1} |π_n| / |π_n|_ < ∞`. -/
def BalancedPartitions {T : ℝ} (π : ℕ → Partition T) : Prop :=
  ∃ M₁ : ℝ, ∀ n, 1 ≤ n → (π n).mesh / (π n).minGap ≤ M₁

