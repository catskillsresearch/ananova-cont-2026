      ∫⁻ h, (∫⁻ x, ‖A n (x + h) - A n x‖ₑ ^ p) / ‖h‖ₑ ^ r := by
    intro n
    rw [← lintegral_gagliardo_eq_shift (hAm n) p r]
    refine lintegral_mono fun x => lintegral_mono fun y => ?_
