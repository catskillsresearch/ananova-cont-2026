/-- The Bessel `(α, p)`-capacity (Definition 2.7):
`B_{α,p}(E) := inf {‖h‖_p^p : g_α ⋆ h ≥ 1_E, h ≥ 0}`. -/
def besselCapacity (d : ℕ) (α : ℝ) (p : ℝ≥0∞) (S : Set (Rd d)) : ℝ≥0∞ :=
  ⨅ (h : Rd d → ℝ) (_ : 0 ≤ h) (_ : ∀ x ∈ S, 1 ≤ BesselSpace.potential d α h x),
    eLpNorm h p volume ^ p.toReal

