theorem lintegral_closedBall_le (f : Rd d → ℝ) (a : Rd d) {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ ≤ 1) :
    ∫⁻ x in Metric.closedBall a ρ, ‖f x‖ₑ ≤
