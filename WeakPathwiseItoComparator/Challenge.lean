/-! ## `WeakPathwiseIto.Occupation.IncrementBall` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The ball `Q^n_i := {x : |x - (a + b)/2| ≤ |b - a| / 2}` spanned by an increment from
`a = ω(t_i)` to `b = ω(t_{i+1})` (eq. (7)). -/
def incrementBall {d : ℕ} (a b : Rd d) : Set (Rd d) :=
  Metric.closedBall (midpoint ℝ a b) (dist a b / 2)

end

/-! ## `WeakPathwiseIto.Occupation.DiscreteOccupationDensity` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

namespace discreteOccupationDensity

variable {d : ℕ}

open scoped Classical in
/-- The single-increment density `𝓛^{n,i}_ω(x) = c_d (|x - a|^{2-d} + |x - b|^{2-d}) 1_{Q}(x)`
for an increment from `a` to `b`, set to `0` when `a = b` (eq. (7)). -/
def piece (a b : Rd d) (x : Rd d) : ℝ :=
  if a = b then 0 else
    (incrementBall a b).indicator
      (fun x => occupationConstant d * (‖x - a‖ ^ (2 - (d : ℝ)) + ‖x - b‖ ^ (2 - (d : ℝ)))) x

end discreteOccupationDensity

/-- The discrete weighted occupation density `𝓛^{π_n}_ω := ∑_i 𝓛^{n,i}_ω` (eq. (7)). -/
def discreteOccupationDensity {T : ℝ} {d : ℕ} (π : Partition T) (ω : ℝ → Rd d) (x : Rd d) : ℝ :=
  ∑ i : Fin π.m, discreteOccupationDensity.piece (ω (π.left i)) (ω (π.right i)) x

namespace discreteOccupationDensity

variable {T : ℝ} {d : ℕ}

end discreteOccupationDensity

end

/-! ## `WeakPathwiseIto.Occupation.NormalizedQuadraticDensity` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The normalised discrete quadratic-variation density of eq. (28) (also used for (11)):
`ρ_{n,ω}(t) := ∑_i |ω(t_{i+1}) - ω(t_i)|² / (t_{i+1} - t_i) · 1_{[t_i, t_{i+1})}(t)`. -/
def normalizedQuadraticDensity {T : ℝ} {d : ℕ} (π : Partition T) (ω : ℝ → Rd d) (t : ℝ) : ℝ :=
  ∑ i : Fin π.m, (Ico (π.left i) (π.right i)).indicator
    (fun _ => ‖ω (π.right i) - ω (π.left i)‖ ^ 2 / (π.right i - π.left i)) t

end

/-! ## `WeakPathwiseIto.Occupation.DiscreteSeminorm` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The discrete seminorm of Section 4.2 (and `‖h‖_{n,1,B}` of Lemma B.2 for `p = 1`):
`‖h‖_{n,p,ω} := (∑_i (|h(ω(t_i))|^p + |h(ω(t_{i+1}))|^p) |t_{i+1} - t_i|)^{1/p}`, for a
nonnegative extended-real `h` (apply to `‖h‖ₑ` for real `h`). -/
def discreteSeminorm {T : ℝ} {d : ℕ} (π : Partition T) (p : ℝ) (h : Rd d → ℝ≥0∞)
    (ω : ℝ → Rd d) : ℝ≥0∞ :=
  (∑ i : Fin π.m, (h (ω (π.left i)) ^ p + h (ω (π.right i)) ^ p) *
    ENNReal.ofReal (π.right i - π.left i)) ^ (1 / p)

end

/-! ## `WeakPathwiseIto.Sobolev.LocalMaximalFunction` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The truncated Hardy–Littlewood maximal function
`M_R f(x) := sup_{r < R} ⨍_{B(x,r)} |f(y)| dy` (Section 2.1). -/
def localMaximalFunction {d : ℕ} {F : Type*} [NormedAddCommGroup F] (R : ℝ≥0∞)
    (f : Rd d → F) (x : Rd d) : ℝ≥0∞ :=
  ⨆ (r : ℝ) (_ : 0 < r) (_ : ENNReal.ofReal r < R), laverage (volume.restrict (Metric.ball x r)) (fun y => ‖f y‖ₑ)

namespace localMaximalFunction

/-- The full maximal function `M f := M_∞ f`. -/
def full {d : ℕ} {F : Type*} [NormedAddCommGroup F] (f : Rd d → F) (x : Rd d) : ℝ≥0∞ :=
  localMaximalFunction ⊤ f x

end localMaximalFunction

end

/-! ## `WeakPathwiseIto.Occupation.OccupationSeminorm` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The seminorm `‖f‖_{W^0_{ω,π}} := limsup_n ∫ |f(x)| 𝓛^{π_n}_ω(x) dx` (Section 4.2). -/
def occupationSeminorm {T : ℝ} {d : ℕ} {F : Type*} [NormedAddCommGroup F] (π : ℕ → Partition T)
    (ω : ℝ → Rd d) (f : Rd d → F) : ℝ≥0∞ :=
  limsup (fun n => ∫⁻ x, ‖f x‖ₑ * ENNReal.ofReal (discreteOccupationDensity (π n) ω x)) atTop

namespace occupationSeminorm

variable {T : ℝ} {d : ℕ} {F : Type*} [NormedAddCommGroup F]

end occupationSeminorm

end

/-! ## `WeakPathwiseIto.Occupation.ApproximatingSequence` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- An approximating sequence for `F` with weak Hessian `H` along `(ω, π)` (eq. (8)), indexed by `m ≥ 1` (the value at `m = 0` is unconstrained):
`F_m ∈ C^2_b ∩ W^{2,1}`, `F_m(ω(t)) → F(ω(t))` for all `t ∈ [0, T]`, and
`‖∇²F_m - ∇²F‖_{W^0_{ω,π}} → 0`. -/
structure ApproximatingSequence {T : ℝ} {d : ℕ} (π : ℕ → Partition T) (ω : ℝ → Rd d)
    (F : Rd d → ℝ) (H : Rd d → (Rd d →L[ℝ] Rd d)) where
  /-- The approximating functions `F_m`, `m ≥ 1`. -/
  seq : ℕ → Rd d → ℝ
  smooth : ∀ m, 1 ≤ m → ContDiffBounded 2 (seq m)
  sobolev : ∀ m, 1 ≤ m → MemW 2 1 (seq m)
  tendsto_path : ∀ t ∈ Icc 0 T, Tendsto (fun m => seq m (ω t)) atTop (𝓝 (F (ω t)))
  tendsto_hessian :
    Tendsto (fun m => occupationSeminorm π ω (fun x => smoothHessian (seq m) x - H x)) atTop (𝓝 0)

end

/-! ## `WeakPathwiseIto.Main.WeakPathwiseIntegral` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The pathwise integral of a weak gradient (eq. (16)):
`∫_0^t ∇F(ω(s)) d^π ω(s) := lim_m ∫_0^t ∇F_m(ω(s)) d^π ω(s)` along an approximating sequence. -/
def weakPathwiseIntegral {T : ℝ} {d : ℕ} {π : ℕ → Partition T} {ω : ℝ → Rd d} {F : Rd d → ℝ}
    {H : Rd d → (Rd d →L[ℝ] Rd d)} (A : ApproximatingSequence π ω F H) (t : ℝ) : ℝ :=
  limUnder atTop fun m => follmerIntegral π (gradient (A.seq m)) ω t

end

/-! ## `WeakPathwiseIto.Smooth.PathwiseCovariation` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

namespace pathwiseCovariation

/-- Discrete covariation
`∑_k (f(ω(t_{k+1} ∧ t)) - f(ω(t_k ∧ t))) · (ω(t_{k+1} ∧ t) - ω(t_k ∧ t))` along `π_n`. -/
def riemannSum {T : ℝ} {d : ℕ} (π : Partition T) (f : Rd d → Rd d) (ω : ℝ → Rd d) (t : ℝ) : ℝ :=
  ∑ k : Fin π.m, ⟪f (ω (min (π.right k) t)) - f (ω (min (π.left k) t)),
    ω (min (π.right k) t) - ω (min (π.left k) t)⟫

end pathwiseCovariation

/-- The pathwise covariation `[f(ω), ω]_π(t)` (Proposition 3.1), as the limit of the discrete
covariations along `(π_n)`. -/
def pathwiseCovariation {T : ℝ} {d : ℕ} (π : ℕ → Partition T) (f : Rd d → Rd d) (ω : ℝ → Rd d)
    (t : ℝ) : ℝ :=
  limUnder atTop fun n => pathwiseCovariation.riemannSum (π n) f ω t

end

/-! ## `WeakPathwiseIto.Main.WeakCovariation` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The covariation of a weak gradient (eq. (15)):
`[∇F(ω), ω]_π(t) := lim_m [∇F_m(ω), ω]_π(t)` along an approximating sequence. -/
def weakCovariation {T : ℝ} {d : ℕ} {π : ℕ → Partition T} {ω : ℝ → Rd d} {F : Rd d → ℝ}
    {H : Rd d → (Rd d →L[ℝ] Rd d)} (A : ApproximatingSequence π ω F H) (t : ℝ) : ℝ :=
  limUnder atTop fun m => pathwiseCovariation π (gradient (A.seq m)) ω t

end

