    rw [occupationConstant]
    positivity
  have hI0 : I ≠ 0 := fun h => hc0 (by rw [hc, h, inv_zero])
  have hpow : l ^ d * l ^ (2 - (d : ℝ)) = l ^ 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_add hl, show (d : ℝ) + (2 - d) = 2 by ring]
    norm_cast
