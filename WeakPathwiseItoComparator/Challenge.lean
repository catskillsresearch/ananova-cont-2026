def weakCovariation {T : ℝ} {d : ℕ} {π : ℕ → Partition T} {ω : ℝ → Rd d} {F : Rd d → ℝ}
    {H : Rd d → (Rd d →L[ℝ] Rd d)} (A : ApproximatingSequence π ω F H) (t : ℝ) : ℝ :=
