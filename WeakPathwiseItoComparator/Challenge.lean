          Real.enorm_eq_ofReal (hc i), ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
          inv_mul_cancel₀ hq.ne', ENNReal.rpow_one]
    _ = ∫⁻ t in ⋃ i, Ico (π.left i) (π.right i), ‖normalizedQuadraticDensity π ω t‖ₑ ^ q := by
