/-- `G` is a weak gradient `∇f` of `f`: each coordinate `G^i` is the weak derivative `∂_i f`. -/
def IsWeakGradient {d : ℕ} (f : Rd d → ℝ) (G : Rd d → Rd d) : Prop :=
  ∀ i : Fin d, IsWeakDerivative (Pi.single i 1) f (fun x => Rd.coord i (G x))

end

