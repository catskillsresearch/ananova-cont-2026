  refine (eLpNorm_mollify_sub_le hp hf (hψc n) (hψ0 n) (hψ1 n) (hψs n)).trans (iSup₂_le ?_)
  intro z hz
  refine hball z (Metric.ball_subset_ball ?_ hz)
  refine le_trans ?_ hN.le
  gcongr
-/

