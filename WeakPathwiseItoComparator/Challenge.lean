    with hc
  have hc0 : ∀ i, 0 ≤ c i := fun i => div_nonneg (sq_nonneg _) (by linarith [π.left_lt_right i])
  have hdisj : ∀ i j : Fin π.m, i ≠ j → ∀ t, t ∈ Ico (π.left i) (π.right i) →
      t ∉ Ico (π.left j) (π.right j) := by
