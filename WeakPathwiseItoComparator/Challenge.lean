open scoped Classical in
/-- The discrete quadratic variation of eq. (5):
`∑_{t_{i+1} ≤ t} (x(t_{i+1}) - x(t_i))²` along a partition `π_n`. -/
def discreteQuadraticVariation {T : ℝ} (π : Partition T) (x : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∑ i ∈ Finset.univ.filter (fun i => π.right i ≤ t), (x (π.right i) - x (π.left i)) ^ 2

end

/-! ## `WeakPathwiseIto.Smooth.HasScalarQuadraticVariation` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

/-- A real path `x` has finite quadratic variation along `π = (π_n)` (eq. (5), [Föl81]):
for every `t ∈ [0, T]` the discrete quadratic variations converge to `[x]_π(t)`, and
`t ↦ [x]_π(t)` is continuous and increasing on `[0, T]`. -/
structure HasScalarQuadraticVariation {T : ℝ} (π : ℕ → Partition T) (x : ℝ → ℝ) where
  /-- The quadratic variation `[x]_π` (only its values on `[0, T]` matter). -/
  qv : ℝ → ℝ
  tendsto : ∀ t ∈ Icc 0 T,
    Tendsto (fun n => discreteQuadraticVariation (π n) x t) atTop (𝓝 (qv t))
  continuousOn : ContinuousOn qv (Icc 0 T)
  monotoneOn : MonotoneOn qv (Icc 0 T)

namespace HasScalarQuadraticVariation

variable {T : ℝ} {π : ℕ → Partition T} {x : ℝ → ℝ} (h : HasScalarQuadraticVariation π x)

/-- **Subgoal** (Eq. (5) Stieltjes measure): `[x]_π` extended constantly outside `[0, T]`,
`t ↦ [x]_π(max 0 (min t T))`, a monotone function on `ℝ` carrying the measure `d[x]_π`. -/
def qvExt (t : ℝ) : ℝ := h.qv (max 0 (min t T))

/-- **Subgoal** (Eq. (5) Stieltjes measure): the extension `qvExt` is monotone. -/
theorem qvExt_monotone : Monotone h.qvExt := by
  have hT : 0 ≤ T := (π 0).nonneg
  intro a b hab
  exact h.monotoneOn ⟨le_max_left _ _, max_le hT (min_le_right _ _)⟩
    ⟨le_max_left _ _, max_le hT (min_le_right _ _)⟩ (max_le_max le_rfl (min_le_min hab le_rfl))

/-- The Stieltjes measure `d[x]_π`. -/
def stieltjesMeasure : Measure ℝ := h.qvExt_monotone.stieltjesFunction.measure

/-- The Riemann–Stieltjes integral `∫_0^t g(u) d[x]_π(u)`. -/
def integral (g : ℝ → ℝ) (t : ℝ) : ℝ := ∫ u in Ioc 0 t, g u ∂h.stieltjesMeasure

end HasScalarQuadraticVariation

end

/-! ## `WeakPathwiseIto.Smooth.HasQuadraticVariation` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

/-- A path `ω = (ω^1, …, ω^d)` has finite quadratic variation along `π` (Section 3): every
`ω^i` and every `ω^i + ω^j` has finite quadratic variation along `π`. The quadratic
covariation `[ω]_{ij}` is then obtained by polarization. -/
structure HasQuadraticVariation {T : ℝ} {d : ℕ} (π : ℕ → Partition T) (ω : ℝ → Rd d) where
  coord : ∀ i : Fin d, HasScalarQuadraticVariation π (fun t => Rd.coord i (ω t))
  pair : ∀ i j : Fin d,
    HasScalarQuadraticVariation π (fun t => Rd.coord i (ω t) + Rd.coord j (ω t))

namespace HasQuadraticVariation

variable {T : ℝ} {d : ℕ} {π : ℕ → Partition T} {ω : ℝ → Rd d} (h : HasQuadraticVariation π ω)

/-- The quadratic covariation `[ω]_{ij} = ([ω^i + ω^j] - [ω^i] - [ω^j]) / 2`. -/
def covariation (i j : Fin d) (t : ℝ) : ℝ :=
  ((h.pair i j).qv t - (h.coord i).qv t - (h.coord j).qv t) / 2

/-- The trace `tr [ω]_π(t) = ∑_i [ω^i]_π(t)`. -/
def trace (t : ℝ) : ℝ := ∑ i, (h.coord i).qv t

/- [omitted from the Challenge: not used by the compared statements]
/-- **Subgoal** (Lemma 4.2 trace measure): `tr [ω]_π` is increasing on `[0, T]`. -/
theorem trace_monotoneOn : MonotoneOn h.trace (Icc 0 T) := fun _ ha _ hb hab =>
  Finset.sum_le_sum fun i _ => (h.coord i).monotoneOn ha hb hab
-/

/-- **Subgoal** (Lemma 4.2 trace measure): `tr [ω]_π` extended constantly outside `[0, T]`. -/
def traceExt (t : ℝ) : ℝ := ∑ i, (h.coord i).qvExt t

/-- **Subgoal** (Lemma 4.2 trace measure): the extended trace is monotone. -/
theorem traceExt_monotone : Monotone h.traceExt := fun _ _ hab =>
  Finset.sum_le_sum fun i _ => (h.coord i).qvExt_monotone hab

/-- The Stieltjes measure `d tr[ω]_π`. -/
def traceMeasure : Measure ℝ := h.traceExt_monotone.stieltjesFunction.measure

/-- The matrix Stieltjes integral `∫_0^t ⟨G(u), d[ω]_π(u)⟩ = ∑_{i,j} ∫_0^t G_{ij}(u) d[ω]_{ij}(u)`,
computed by polarization. -/
def matrixIntegral (G : ℝ → Fin d → Fin d → ℝ) (t : ℝ) : ℝ :=
  ∑ i, ∑ j, ((h.pair i j).integral (fun u => G u i j) t - (h.coord i).integral (fun u => G u i j) t -
    (h.coord j).integral (fun u => G u i j) t) / 2

/- [omitted from the Challenge: not used by the compared statements]
open scoped Classical in
/-- **Subgoal** (Section 3 Q^π(ℝ^d)). Section 3: the discrete cross sums
`∑_{t_{k+1} ≤ t} (ω^i(t_{k+1}) - ω^i(t_k))(ω^j(t_{k+1}) - ω^j(t_k))` converge to `[ω]_{ij}(t)`. -/
theorem tendsto_cross (i j : Fin d) {t : ℝ} (ht : t ∈ Icc 0 T) :
    Tendsto (fun n => ∑ k ∈ Finset.univ.filter (fun k => (π n).right k ≤ t),
      (Rd.coord i (ω ((π n).right k)) - Rd.coord i (ω ((π n).left k))) *
        (Rd.coord j (ω ((π n).right k)) - Rd.coord j (ω ((π n).left k))))
      atTop (𝓝 (h.covariation i j t)) := by
  have e : ∀ n, (∑ k ∈ Finset.univ.filter (fun k => (π n).right k ≤ t),
      (Rd.coord i (ω ((π n).right k)) - Rd.coord i (ω ((π n).left k))) *
        (Rd.coord j (ω ((π n).right k)) - Rd.coord j (ω ((π n).left k)))) =
      (discreteQuadraticVariation (π n) (fun t => Rd.coord i (ω t) + Rd.coord j (ω t)) t -
        discreteQuadraticVariation (π n) (fun t => Rd.coord i (ω t)) t -
        discreteQuadraticVariation (π n) (fun t => Rd.coord j (ω t)) t) / 2 := by
    intro n
    unfold discreteQuadraticVariation
    rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, Finset.sum_div]
    exact Finset.sum_congr rfl fun k _ => by ring
  refine Tendsto.congr (fun n => (e n).symm) ?_
  exact ((((h.pair i j).tendsto t ht).sub ((h.coord i).tendsto t ht)).sub
    ((h.coord j).tendsto t ht)).div_const 2
-/

end HasQuadraticVariation

end

/-! ## `WeakPathwiseIto.Smooth.PathOscillation` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

/-- The oscillation of `ω` along `π_n` (eq. (6)):
`osc(ω, π_n) := max_i sup_{t ∈ [t_i, t_{i+1}]} |ω(t) - ω(t_i)|`. -/
def pathOscillation {T : ℝ} {d : ℕ} (ω : ℝ → Rd d) (π : Partition T) : ℝ :=
  ⨆ i : Fin π.m, ⨆ (s : ℝ) (_ : s ∈ Icc (π.left i) (π.right i)), ‖ω s - ω (π.left i)‖

namespace pathOscillation

variable {T : ℝ} {d : ℕ}

/-- Condition (6): `osc(ω, π_n) → 0`. -/
def Vanishes (ω : ℝ → Rd d) (π : ℕ → Partition T) : Prop :=
  Tendsto (fun n => pathOscillation ω (π n)) atTop (𝓝 0)

/- [omitted from the Challenge: not used by the compared statements]
/-- **Subgoal** (Eq. (6)). Section 3: if `|π_n| → 0` and `ω` is continuous, condition (6) holds. -/
theorem vanishes_of_mesh {ω : ℝ → Rd d} {π : ℕ → Partition T}
    (hω : ContinuousOn ω (Icc 0 T)) (hπ : Tendsto (fun n => (π n).mesh) atTop (𝓝 0)) :
    Vanishes ω π := by
  have hu := isCompact_Icc.uniformContinuousOn_of_continuous hω
  rw [Metric.uniformContinuousOn_iff] at hu
  rw [Vanishes, Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨δ, hδ, hδε⟩ := hu (ε / 2) (by positivity)
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.1 hπ δ hδ
  refine ⟨N, fun n hn => ?_⟩
  have hmesh : (π n).mesh < δ := by
    have := hN n hn
    rw [Real.dist_eq, sub_zero] at this
    exact (le_abs_self _).trans_lt this
  have hle : pathOscillation ω (π n) ≤ ε / 2 := by
    refine Real.iSup_le (fun i => Real.iSup_le (fun s => Real.iSup_le (fun hs => ?_)
      (by positivity)) (by positivity)) (by positivity)
    have hl := (π n).t_mem i.castSucc
    have hr := (π n).t_mem i.succ
    have hs1 : (π n).left i ≤ s := hs.1
    have hs2 : s ≤ (π n).right i := hs.2
    have hl' : (π n).left i ∈ Icc 0 T := hl
    have hr' : (π n).right i ∈ Icc 0 T := hr
    have hsT : s ∈ Icc 0 T := ⟨hl'.1.trans hs1, hs2.trans hr'.2⟩
    have hgap := (π n).gap_le_mesh i
    have := hδε s hsT ((π n).left i) hl' (by
      rw [Real.dist_eq, abs_of_nonneg (by linarith)]; linarith)
    rw [dist_eq_norm] at this
    exact this.le
  have h0 : 0 ≤ pathOscillation ω (π n) :=
    Real.iSup_nonneg fun i => Real.iSup_nonneg fun s => Real.iSup_nonneg fun _ => norm_nonneg _
  rw [Real.dist_eq, sub_zero, abs_of_nonneg h0]
  linarith
-/

end pathOscillation

end

/-! ## `WeakPathwiseIto.Sobolev.IsWeakDerivative` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

namespace IsWeakDerivative

variable {d : ℕ}

/-- The order `|α| = α_1 + ⋯ + α_d` of a multi-index `α`. -/
def order (α : Fin d → ℕ) : ℕ := ∑ i, α i

/-- The list of directions `e_1 (α_1 times), …, e_d (α_d times)` of a multi-index `α`. -/
def directions (α : Fin d → ℕ) : List (Rd d) :=
  (List.finRange d).flatMap fun i => List.replicate (α i) (Rd.basisVec i)

/-- The classical partial derivative `D^α φ` of a smooth test function. -/
def testDeriv (α : Fin d → ℕ) (φ : Rd d → ℝ) (x : Rd d) : ℝ :=
  iteratedFDeriv ℝ (directions α).length φ x (fun k => (directions α).get k)

end IsWeakDerivative

/-- `g` is the weak derivative `D^α f` of `f` (Section 2.1): both are locally integrable and
`∫ f D^α φ = (-1)^{|α|} ∫ g φ` for all smooth compactly supported test functions `φ`. -/
def IsWeakDerivative {d : ℕ} (α : Fin d → ℕ) (f g : Rd d → ℝ) : Prop :=
  LocallyIntegrable f ∧ LocallyIntegrable g ∧
    ∀ φ : Rd d → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ → HasCompactSupport φ →
      ∫ x, f x * IsWeakDerivative.testDeriv α φ x =
        (-1) ^ IsWeakDerivative.order α * ∫ x, g x * φ x

end

/-! ## `WeakPathwiseIto.Sobolev.IsWeakHessian` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

/-- `H` is a weak Hessian `∇²f` of `f`: the `(i, j)` entry `⟨H(x) e_j, e_i⟩` is the weak
derivative `∂_i ∂_j f`. -/
def IsWeakHessian {d : ℕ} (f : Rd d → ℝ) (H : Rd d → (Rd d →L[ℝ] Rd d)) : Prop :=
  ∀ i j : Fin d, IsWeakDerivative (Pi.single i 1 + Pi.single j 1) f
    (fun x => Rd.coord i (H x (Rd.basisVec j)))

end

/-! ## `WeakPathwiseIto.Smooth.FollmerIntegral` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

namespace follmerIntegral

/-- Left Riemann sum `∑_k ⟨g(ω(t_k ∧ t)), ω(t_{k+1} ∧ t) - ω(t_k ∧ t)⟩` along `π_n`. -/
def riemannSum {T : ℝ} {d : ℕ} (π : Partition T) (g : Rd d → Rd d) (ω : ℝ → Rd d) (t : ℝ) : ℝ :=
  ∑ k : Fin π.m, ⟪g (ω (min (π.left k) t)), ω (min (π.right k) t) - ω (min (π.left k) t)⟫

end follmerIntegral

/-- The pathwise (Föllmer) integral `∫_0^t g(ω) d^π ω`, defined as the limit of left Riemann
sums along `(π_n)` (Corollary 3.2, [Föl81]). -/
def follmerIntegral {T : ℝ} {d : ℕ} (π : ℕ → Partition T) (g : Rd d → Rd d) (ω : ℝ → Rd d)
    (t : ℝ) : ℝ :=
  limUnder atTop fun n => follmerIntegral.riemannSum (π n) g ω t

end

/-! ## `WeakPathwiseIto.Basic.ContDiffBounded` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

open MeasureTheory Filter Topology Set
open scoped ENNReal NNReal RealInnerProductSpace

/-- `C^k_b`: `f` is `k` times continuously differentiable and all its derivatives of order
`≤ k` are bounded (the spaces `C^1_b`, `C^2_b` of the paper). -/
def ContDiffBounded {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] (k : ℕ) (f : E → F) : Prop :=
  ContDiff ℝ k f ∧ ∀ i ≤ k, ∃ C : ℝ, ∀ x, ‖iteratedFDeriv ℝ i f x‖ ≤ C

end

