section

/-- The oscillation of `ω` along `π_n` (eq. (6)):
`osc(ω, π_n) := max_i sup_{t ∈ [t_i, t_{i+1}]} |ω(t) - ω(t_i)|`. -/
def pathOscillation {T : ℝ} {d : ℕ} (ω : ℝ → Rd d) (π : Partition T) : ℝ :=
  ⨆ i : Fin π.m, ⨆ (s : ℝ) (_ : s ∈ Icc (π.left i) (π.right i)), ‖ω s - ω (π.left i)‖

namespace pathOscillation

variable {T : ℝ} {d : ℕ}

/-- Condition (6): `osc(ω, π_n) → 0`. -/
def Vanishes (ω : ℝ → Rd d) (π : ℕ → Partition T) : Prop :=
  Tendsto (fun n => pathOscillation ω (π n)) atTop (𝓝 0)

end pathOscillation

end

/-! ## `WeakPathwiseIto.Sobolev.IsWeakDerivative` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

namespace IsWeakDerivative

variable {d : ℕ}

/-- The order `|α| = α_1 + ⋯ + α_d` of a multi-index `α`. -/
def order (α : Fin d → ℕ) : ℕ := ∑ i, α i

/-- The list of directions `e_1 (α_1 times), …, e_d (α_d times)` of a multi-index `α`. -/
def directions (α : Fin d → ℕ) : List (Rd d) :=
  (List.finRange d).flatMap fun i => List.replicate (α i) (Rd.basisVec i)

/-- The classical partial derivative `D^α φ` of a smooth test function. -/
def testDeriv (α : Fin d → ℕ) (φ : Rd d → ℝ) (x : Rd d) : ℝ :=
  iteratedFDeriv ℝ (directions α).length φ x (fun k => (directions α).get k)

end IsWeakDerivative

/-- `g` is the weak derivative `D^α f` of `f` (Section 2.1): both are locally integrable and
`∫ f D^α φ = (-1)^{|α|} ∫ g φ` for all smooth compactly supported test functions `φ`. -/
def IsWeakDerivative {d : ℕ} (α : Fin d → ℕ) (f g : Rd d → ℝ) : Prop :=
  LocallyIntegrable f ∧ LocallyIntegrable g ∧
    ∀ φ : Rd d → ℝ, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) φ → HasCompactSupport φ →
      ∫ x, f x * IsWeakDerivative.testDeriv α φ x =
        (-1) ^ IsWeakDerivative.order α * ∫ x, g x * φ x

end

/-! ## `WeakPathwiseIto.Sobolev.IsWeakHessian` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- `H` is a weak Hessian `∇²f` of `f`: the `(i, j)` entry `⟨H(x) e_j, e_i⟩` is the weak
derivative `∂_i ∂_j f`. -/
def IsWeakHessian {d : ℕ} (f : Rd d → ℝ) (H : Rd d → (Rd d →L[ℝ] Rd d)) : Prop :=
  ∀ i j : Fin d, IsWeakDerivative (Pi.single i 1 + Pi.single j 1) f
    (fun x => Rd.coord i (H x (Rd.basisVec j)))

end

/-! ## `WeakPathwiseIto.Smooth.FollmerIntegral` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

namespace follmerIntegral

/-- Left Riemann sum `∑_k ⟨g(ω(t_k ∧ t)), ω(t_{k+1} ∧ t) - ω(t_k ∧ t)⟩` along `π_n`. -/
def riemannSum {T : ℝ} {d : ℕ} (π : Partition T) (g : Rd d → Rd d) (ω : ℝ → Rd d) (t : ℝ) : ℝ :=
  ∑ k : Fin π.m, ⟪g (ω (min (π.left k) t)), ω (min (π.right k) t) - ω (min (π.left k) t)⟫

end follmerIntegral

/-- The pathwise (Föllmer) integral `∫_0^t g(ω) d^π ω`, defined as the limit of left Riemann
sums along `(π_n)` (Corollary 3.2, [Föl81]). -/
def follmerIntegral {T : ℝ} {d : ℕ} (π : ℕ → Partition T) (g : Rd d → Rd d) (ω : ℝ → Rd d)
    (t : ℝ) : ℝ :=
  limUnder atTop fun n => follmerIntegral.riemannSum (π n) g ω t

end

/-! ## `WeakPathwiseIto.Basic.ContDiffBounded` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- `C^k_b`: `f` is `k` times continuously differentiable and all its derivatives of order
`≤ k` are bounded (the spaces `C^1_b`, `C^2_b` of the paper). -/
def ContDiffBounded {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] (k : ℕ) (f : E → F) : Prop :=
  ContDiff ℝ k f ∧ ∀ i ≤ k, ∃ C : ℝ, ∀ x, ‖iteratedFDeriv ℝ i f x‖ ≤ C

end

/-! ## `WeakPathwiseIto.Basic.SmoothHessian` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The classical Hessian `∇²F(x)` of a twice differentiable `F : ℝ^d → ℝ`, as the derivative
of the gradient, a linear map `ℝ^d →L ℝ^d`. -/
def smoothHessian {d : ℕ} (F : Rd d → ℝ) (x : Rd d) : Rd d →L[ℝ] Rd d :=
  fderiv ℝ (gradient F) x

end

/-! ## `WeakPathwiseIto.Sobolev.MemW` -/

run_cmd Lean.modifyEnv fun env => Lean.Meta.auxLemmasExt.setState env {}

section

/-- The Sobolev space `W^{k,p}(ℝ^d)` (Section 2.1): `f ∈ L^p` and every weak derivative
`D^α f`, `|α| ≤ k`, exists and lies in `L^p`. -/
def MemW {d : ℕ} (k : ℕ) (p : ℝ≥0∞) (f : Rd d → ℝ) : Prop :=
  MemLp f p ∧ ∀ α : Fin d → ℕ, IsWeakDerivative.order α ≤ k →
    ∃ g : Rd d → ℝ, IsWeakDerivative α f g ∧ MemLp g p

namespace MemW

/-- The finite set of multi-indices `α ∈ ℕ^d` with `|α| ≤ k`. -/
def multiIndices (d k : ℕ) : Finset (Fin d → ℕ) :=
  ((Finset.univ : Finset (Fin d → Fin (k + 1))).image fun α i => (α i : ℕ)).filter
    fun α => IsWeakDerivative.order α ≤ k

/-- The Sobolev norm `‖f‖_{W^{k,p}} := ∑_{|α| ≤ k} ‖D^α f‖_{L^p}` (Theorem 2.6), `D^0 f = f`.
Weak derivatives are unique a.e., so the infimum over versions is the norm of any version. -/
def norm {d : ℕ} (k : ℕ) (p : ℝ≥0∞) (f : Rd d → ℝ) : ℝ≥0∞ :=
  ∑ α ∈ multiIndices d k, ⨅ (g : Rd d → ℝ) (_ : IsWeakDerivative α f g), eLpNorm g p volume

end MemW

end

