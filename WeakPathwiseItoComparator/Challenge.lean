      funext x; simp [convolution_def, smul_eq_mul]
    rw [this]
    exact hgc.continuous_convolution_left _ hgcont (hψint n).locallyIntegrable
  have hpt : ∀ x, ‖(∫ y, h y * ψ n (x - y)) - h x‖ₑ ≤
      (‖∫ y, (h - g) y * ψ n (x - y)‖ₑ + ‖(∫ y, g y * ψ n (x - y)) - g x‖ₑ) + ‖(g - h) x‖ₑ := by
    intro x
