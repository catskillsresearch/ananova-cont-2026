        rw [← ENNReal.ofReal_mul (by positivity), div_mul_cancel₀ _ hΔ.ne']
    _ = (h (ω (π.right i)) + h (ω (π.left i))) * (ENNReal.ofReal (‖ω (π.right i) - ω (π.left i)‖ ^ 2 /
        (π.right i - π.left i)) * (ENNReal.ofReal (π.right i - π.left i) ^ p⁻¹ *
